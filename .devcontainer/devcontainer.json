{
  "name": "Build-It",
  "dockerComposeFile": "compose.json",
  "service": "dev",
  "workspaceFolder": "/Build-It",
  "remoteUser": "vscode",
  // "initializeCommand": ".devcontainer/scripts/select-db.sh",
  "features": {
    "ghcr.io/agustin-gigena/devcontainer-features/dotnet-tools:1.0.0": {
      "tools": "dotnet-ef"
    },
    "ghcr.io/devcontainers-extra/features/apt-get-packages:1": {
      "packages": "default-mysql-client docker.io libnss3 libnspr4 libgbm1 libasound2t64 clang zlib1g-dev lld"
    },
    "ghcr.io/devcontainers/features/node:2.1.0": {},
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/iyaki/devcontainer-features/lefthook:2.0.1": {},
    "ghcr.io/iyaki/devcontainer-features/oh-my-pi:1": {},
    "ghcr.io/devcontainers/features/aws-cli:1": {},
    "ghcr.io/devcontainers-extra/features/aws-cdk:2": {}
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-dotnettools.csdevkit",
        "ms-dotnettools.csharp",
        "editorconfig.editorconfig",
        "AmazonWebServices.aws-toolkit-vscode"
      ]
    }
  },
  "forwardPorts": [8080, 8081],
  "postCreateCommand": ".devcontainer/scripts/setup.sh"
}
