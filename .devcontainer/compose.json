{
  "name": "build_it",
  "services": {
    "dev": {
      "image": "mcr.microsoft.com/devcontainers/dotnet:dev-10.0-noble",
      "init": true,
      "security_opt": ["label=disable"],
      "user": "vscode",
      "userns_mode": "keep-id",
      "command": "sleep infinity",
      "sysctls": {
        "net.ipv6.conf.all.disable_ipv6": "1",
        "net.ipv6.conf.default.disable_ipv6": "1"
      },
      "volumes": [
        "..:/Build_it:cached",
        "${BUILD_IT_DOCKER_SOCKET}:/var/run/docker.sock",
        "${HOME}/.omp:/home/vscode/.omp",
        "${HOME}/.config/gh:/home/vscode/.config/gh",
        "${HOME}/.aspnet:/home/vscode/.aspnet",
        "nuget-packages:/home/vscode/.nuget"
      ],
      "depends_on": { "db": { "condition": "service_healthy" } }
    },
    "db": {
      "image": "${BUILD_IT_DB_IMAGE:-ghcr.io/agustin-gigena/build-it-db-production:latest}",
      "environment": {
        "MYSQL_ROOT_PASSWORD": "build_it_root",
        "MYSQL_DATABASE": "build_it",
        "MYSQL_USER": "build_it",
        "MYSQL_PASSWORD": "build_it"
      },
      "ports": ["3306:3306"],
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "mysqladmin ping --host=127.0.0.1 --user=root --password=\"$${MYSQL_ROOT_PASSWORD}\" --silent"
        ],
        "interval": "5s",
        "timeout": "3s",
        "retries": 10
      },
      "restart": "unless-stopped"
    }
  },
  "volumes": {
    "nuget-packages": {}
  }
}
