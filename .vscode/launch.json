{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Api",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build: api",
      "program": "${workspaceFolder}/src/BuildIt.Api/bin/Debug/net10.0/BuildIt.Api.dll",
      "cwd": "${workspaceFolder}/src/BuildIt.Api",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://0.0.0.0:8080"
      }
    },
    {
      "name": "Web",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build: web",
      "program": "${workspaceFolder}/src/BuildIt.Web/bin/Debug/net10.0/BuildIt.Web.dll",
      "cwd": "${workspaceFolder}/src/BuildIt.Web",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://0.0.0.0:5000"
      },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
      }
    },
    {
      "name": "Maui (Android)",
      "type": "dotnet",
      "request": "launch",
      "projectPath": "${workspaceFolder}/src/BuildIt.Maui/BuildIt.Maui.csproj",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      }
    }
  ],
  "compounds": [
    {
      "name": "API + WEB",
      "configurations": ["Api", "Web"],
      "stopAll": true
    },
    {
      "name": "API + MAUI (Android)",
      "configurations": ["Api", "Maui (Android)"],
      "stopAll": true
    }
  ]
}
