@page "/counter"

<PageTitle>Contador</PageTitle>

<h1>Contador</h1>

<p role="status">Cuenta actual: @currentCount</p>

<button class="btn btn-primary" @onclick="IncrementCount">Contar</button>

@code {
    private int currentCount;

    private void IncrementCount()
    {
        currentCount++;
    }
}
