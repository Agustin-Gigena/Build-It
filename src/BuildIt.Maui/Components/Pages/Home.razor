@page "/"
@using System.Net.Http.Json
@inject HttpClient Http

<h1>BuildIt</h1>

@if (_status is null)
{
    <p>Conectando con la API…</p>
}
else
{
    <p>API: <strong>@_status.App</strong> (@_status.Environment)</p>
    <p>Hora del servidor: @_status.ServerTimeUtc.ToString("u")</p>
}

@code
{
    private StatusResponse? _status;

    protected override async Task OnInitializedAsync() =>
        _status = await Http.GetFromJsonAsync<StatusResponse>("api/status");

    private sealed record StatusResponse(string App, string Environment, DateTimeOffset ServerTimeUtc);
}
